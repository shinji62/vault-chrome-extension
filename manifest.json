{
  "manifest_version": 3,
  "name": "Vault Password Manager",
  "version": "0.1.0",
  "description": "HashiCorp Vault password manager for Chrome",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Vault Password Manager"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ],
  "permissions": ["storage", "identity", "activeTab", "scripting", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"]
}
